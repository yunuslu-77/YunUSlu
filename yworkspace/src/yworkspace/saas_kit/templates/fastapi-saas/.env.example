SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@example.com
# Billing: fake (test mode) | stripe | iyzico
BILLING_PROVIDER=fake
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
