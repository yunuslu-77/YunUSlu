# ===== YAi ayarları — bu dosyayı .env olarak kopyala ve doldur =====
BOT_NAME=YAi

# Google AI Studio → Get API key (Cloud projesine bağlı, faturalandırma açık)
GEMINI_API_KEY=

# Modeller (Kasım 2026). Ucuz model günlük işler, akıllı model zor işler için.
MODEL_FAST=gemini-3.5-flash-lite
MODEL_SMART=gemini-3.8-flash
MODEL_TTS=gemini-3.8-flash-lite-tts
TTS_VOICE=Kore

# Telegram: @BotFather → /newbot → token
TELEGRAM_TOKEN=
# Botu ilk açtığında /start yaz, sana ID'ni söyler
TELEGRAM_OWNER_ID=

TIMEZONE=Europe/Istanbul

# Bütçe (10 $ kredi için güvenli pay bırakıldı)
MONTHLY_LIMIT_USD=9.0
DAILY_LIMIT_USD=0.40

# Panel ve telefon köprüsü için uzun rastgele şifreler (deploy/install.sh otomatik üretir)
# Üretmek için: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
DASHBOARD_TOKEN=
PHONE_TOKEN=
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
# YAi Android uygulamasının bağlanacağı adres (Tailscale IP'si): http://100.x.y.z:8080
PUBLIC_URL=

# Bildirimi Telegram'a iletilecek telefon uygulamaları (paket adı parçaları)
PHONE_NOTIFY_APPS=com.whatsapp,com.google.android.gm,com.instagram.android
PHONE_BATTERY_THRESHOLD=15

# Proaktif kontroller
PROACTIVE_EMAIL_MINUTES=20
PROACTIVE_CALENDAR_MINUTES=15
LEARNING_ENABLED=true

# Botun terminal kullanması (her komut yine de onay ister)
SHELL_ENABLED=true

# Boş bırak: Playwright'ın kendi Chromium'u kullanılır
BROWSER_EXECUTABLE=
